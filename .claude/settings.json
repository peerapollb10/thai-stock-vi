{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(git *)",
      "Bash(python *)",
      "PowerShell(npm run *)",
      "PowerShell(git *)",
      "PowerShell(python *)",
      "Bash(node scripts/*)",
      "PowerShell(node scripts/*)",
      "Bash(.venv/Scripts/python *)",
      "PowerShell(.venv\\Scripts\\python *)",
      "Bash(npx next *)",
      "Bash(curl * http://localhost:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -f*)",
      "Read(./.env.local)",
      "Read(./.env)"
    ]
  }
}
