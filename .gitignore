# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# log การดึงหุ้นทั้งตลาด (fetch_stocks.py)
/data/*.log

