# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ไฟล์ .env* ถูก .gitignore ไว้ ยกเว้นไฟล์ตัวอย่างนี้)

# --- Supabase (Dashboard → Project Settings → API) ---
# ค่าสองตัวนี้ถูกส่งไปที่เบราว์เซอร์ได้อย่างปลอดภัย เพราะข้อมูลถูกป้องกันด้วย Row Level Security
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) หรือ anon key แบบเดิม
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# ห้ามใส่ service_role / secret key ในตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด

# Secret key (sb_secret_...) หรือ service_role key — ใช้เฉพาะ scripts/fetch_stocks.py เขียนข้อมูลตลาด (ข้าม RLS)
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Telegram Bot (npm run bot — scripts/telegram_bot.js) + แจ้งผล Finish Protocol (scripts/send-telegram.js) ---
# Token: คุยกับ @BotFather → /newbot แล้วคัดลอก Token ที่ได้
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chat ID ของเจ้าของ (บอทรับ/ตอบเฉพาะแชทนี้): ส่งข้อความหาบอทก่อน 1 ครั้ง แล้วเปิด
#   https://api.telegram.org/bot<TOKEN>/getUpdates ดูค่า "chat":{"id":...} (หรือถาม @userinfobot)
# TELEGRAM_CHAT_ID=123456789
# งานแต่ละงานหยุดอัตโนมัติเมื่อเกินกี่นาที
# BOT_TIMEOUT_MIN=15
# ปุ่มอนุมัติงาน (Inline Keyboard) ใช้ได้ภายในกี่นาทีหลังส่ง
# BOT_APPROVAL_TTL_MIN=30

# --- LINE (ระบบเดิม — ไม่ใช้แล้ว เปิดได้ถ้าต้องการ) ---
# SEND_LINE_NOTIFY=true ให้ npm run finish ส่งเข้า LINE ด้วย
SEND_LINE_NOTIFY=false
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_USER_ID=
# LINE bot เดิม (npm run bot:line — scripts/line_bot.js) ใช้ Webhook ผ่าน ngrok
# LINE_CHANNEL_SECRET=
# BOT_PORT=3001
