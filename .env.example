# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ไฟล์ .env* ถูก .gitignore ไว้ ยกเว้นไฟล์ตัวอย่างนี้)

# --- Supabase (Dashboard → Project Settings → API) ---
# ค่าสองตัวนี้ถูกส่งไปที่เบราว์เซอร์ได้อย่างปลอดภัย เพราะข้อมูลถูกป้องกันด้วย Row Level Security
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) หรือ anon key แบบเดิม
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# ห้ามใส่ service_role / secret key ในตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด

# Secret key (sb_secret_...) หรือ service_role key — ใช้เฉพาะ scripts/fetch_stocks.py เขียนข้อมูลตลาด (ข้าม RLS)
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- แจ้งเตือน LINE (ตาม CLAUDE-RULES.md ข้อ 4) ---
SEND_LINE_NOTIFY=false
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_USER_ID=

# --- LINE 2-Way Bot (npm run bot — scripts/line_bot.js) ใช้ LINE_CHANNEL_ACCESS_TOKEN / LINE_USER_ID ข้างบนร่วมด้วย ---
# Channel secret (LINE Developers Console → Messaging API channel → Basic settings) ใช้ตรวจลายเซ็น Webhook
# LINE_CHANNEL_SECRET=
# BOT_PORT=3001
# BOT_TIMEOUT_MIN=15
